{
  "name": "vue-greetings",
  "version": "0.3.0",
  "type": "module",
  "description": "A vue component that returns dynamic greeting based on day, time and season. Ideal for welcome messages in dashboard and user profile",
  "author": {
    "name": "Adeoye Adefemi Opeoluwa"
  },
  "main": "./dist/vue-greetings.umd.cjs",
  "module": "./dist/vue-greetings.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-greetings.js",
      "require": "./dist/vue-greetings.umd.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^5.2.0",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vite-plugin-dts": "^4.3.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.2.0"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/opeolluwa/vue-greetings.git"
  },
  "bugs": {
    "url": "https://github.com/opeolluwa/vue-greetings/issues"
  },
  "homepage": "https://github.com/opeolluwa/vue-greetings#readme",
  "engines": {
    "node": ">=18"
  }
}
